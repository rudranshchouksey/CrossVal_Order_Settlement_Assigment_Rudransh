generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer  String
  dueDate   DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
  payments  Payment[]

  @@index([userId])
  @@index([dueDate])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  quantity    Int    // CHECK constraint >= 1 applied via migration
  unitPrice   Int    // In cents

  @@index([orderId])
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Int      // In cents, CHECK constraint >= 1 applied via migration
  paymentDate DateTime
  note        String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([paymentDate])
}
